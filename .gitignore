# ============================================================
# NimehOS .gitignore
# ============================================================

# === اطلاعات حساس (هرگز commit نشه) ===
config.py
*.local
*.secret
.env
.env.*
*.key
*.pem
*.p12

# === SSH keys ===
*.ssh
id_rsa
id_ed25519
nimeh_key*

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# === Screenshots ===
screenshots/
*.png.bak

# === Logs ===
*.log
logs/
qs.log
caelestia.log
build.log

# === Build artifacts ===
plugin/build/
*.o
*.so
*.a
*.dylib
build/

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*
.DS_Store
Thumbs.db
desktop.ini

# === Virtual environments ===
venv/
.venv/
env/
.env/

# === Temporary files ===
*.tmp
*.bak
*.orig
*.rej
.cache/

# === QML cache ===
*.qmlc
*.qmltc
*.jsc

# === Qt Creator ===
*.pro.user
*.pro.user.*
CMakeLists.txt.user
*.autosave

# === Snapshots / backups ===
backups/
*.tar.gz
*.zip

# === OS specific ===
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
